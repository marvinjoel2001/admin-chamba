# URL de la API del Backend (NestJS)
# Local: http://localhost:3001/api (puerto 3001 para no colisionar con Next.js en puerto 3000)
# Producción: https://web-production-f0db6d.up.railway.app/api
VITE_API_URL=http://localhost:3001/api

# URL de WebSockets
# Local: http://localhost:3001
# Producción: https://web-production-f0db6d.up.railway.app
VITE_SOCKET_URL=http://localhost:3001

# Mapbox Token (para los mapas de Mapbox GL)
VITE_MAPBOX_TOKEN=
